# recast-server settings for compose.yaml — copy to .env and edit.

# Library folders on this server (where your NAS share is mounted). Use the same folders Sonarr/Radarr see.
TV_DIR=/mnt/nas/tv
MOVIES_DIR=/mnt/nas/movies

# recast's own folders. SCRATCH_DIR should be a local disk with room for a few episodes (default budget 200 GB).
CONFIG_DIR=./config
SCRATCH_DIR=./scratch

# Run as the same user/group that owns your media (run `id` as that user to see the numbers).
PUID=1000
PGID=1000

# Working hours ("only start new files 01:00–08:00") follow this server's own timezone automatically.
# Set TZ only to override that, e.g. TZ=America/Phoenix
TZ=

# Port for the web app.
RECAST_PORT=8484

# Optional: connect Sonarr/Radarr on first start (Settings → General → API Key in each). You can also do it in the web app.
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=

# Pin a version instead of following releases, e.g. RECAST_TAG=0.2.0 (or "edge" for the main branch).
RECAST_TAG=latest
